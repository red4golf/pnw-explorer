---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/categories';
import { publishedLocations } from '../lib/publish';

const locations = await publishedLocations();
const counts = Object.fromEntries(
  CATEGORIES.map((c) => [c.slug, locations.filter((l) => l.data.category === c.name).length])
);
---

<Base
  title="Map — PNW Historical Explorer"
  description={`Find all ${locations.length} historic places on an interactive map, filter by interest, locate what is near you, or plan stops along a drive.`}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Explore</p>
      <h1>Where everything is</h1>

      <div class="actions" style="margin-top:1rem">
        <button class="btn" id="locate" type="button">📍 Find places near me</button>
        <button class="btn secondary" id="route-toggle" type="button" aria-expanded="false">
          🛣️ Plan stops along a drive
        </button>
      </div>
      <p id="locate-status" class="status-line" role="status" aria-live="polite"></p>

      <form id="route-form" hidden style="margin:1rem 0;padding:1rem;background:var(--surface-2);border-radius:var(--radius)">
        <p class="eyebrow" style="margin-top:0">Along the way</p>
        <div style="display:grid;gap:0.75rem;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));align-items:end">
          <label>Starting from
            <input id="route-from" name="from" required placeholder="Seattle, WA"
                   autocomplete="off" style="width:100%;padding:0.55rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);color:inherit;font:inherit" />
          </label>
          <label>Going to
            <input id="route-to" name="to" required placeholder="Portland, OR"
                   autocomplete="off" style="width:100%;padding:0.55rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);color:inherit;font:inherit" />
          </label>
          <label>Max detour
            <select id="route-detour" style="width:100%;padding:0.55rem;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--surface);color:inherit;font:inherit">
              <option value="10">10 minutes</option>
              <option value="20">20 minutes</option>
              <option value="30" selected>30 minutes</option>
              <option value="45">45 minutes</option>
              <option value="60">1 hour</option>
            </select>
          </label>
          <div style="display:flex;gap:0.5rem">
            <button class="btn" type="submit">Find stops</button>
            <button class="btn secondary" type="button" id="route-clear" hidden>Clear results</button>
          </div>
        </div>
        <p class="muted" style="font-size:0.8rem;margin:0.75rem 0 0">
          Detour is measured in driving time out and back, not map distance — across water those
          are wildly different things, and only one of them tells you whether to stop. Ferries are
          used where they are the only link and flagged when the route sails, but the router tends
          to prefer driving around even when sailing is quicker, and schedules and terminal waits
          are never counted. Check sailing times yourself. Routing and place lookup by
          OpenStreetMap.
        </p>
        <p id="route-status" class="status-line" role="status" aria-live="polite"></p>
      </form>

      <div class="filters" id="filters" role="group" aria-label="Filter by category">
        <button class="pill active" data-cat="all" data-label="All places" aria-pressed="true">
          All {locations.length}
        </button>
        {CATEGORIES.map((c) => (
          <button class="pill" data-cat={c.slug} data-label={c.name} aria-pressed="false">
            {c.icon} {c.name} {counts[c.slug]}
          </button>
        ))}
      </div>

      <p class="visually-hidden" id="filter-current" role="status" aria-live="polite">All places</p>

      <div id="map" data-locations-url="/locations.json"></div>

      <div id="results" hidden style="margin-top:1.5rem">
        <h2 id="results-title">Results</h2>
        <ul class="nearby-list" id="results-list"></ul>
      </div>

      <noscript>
        <p class="muted" style="margin-top:1rem">
          The map needs JavaScript. <a href="/categories">Browse by category</a> instead — every
          location page lists its coordinates and a directions link.
        </p>
      </noscript>
    </div>
  </section>

  <script>
    import L from 'leaflet';
    import 'leaflet.markercluster';
    // Bundled, not loaded from a CDN. Two reasons: this is an offline-capable
    // guide and the service worker only caches this origin, so a CDN stylesheet
    // means an unstyled map in the field; and Leaflet derives its icon
    // imagePath from wherever leaflet.css came from, which silently rewrote
    // every marker URL to point at unpkg (see the icon note below).
    import 'leaflet/dist/leaflet.css';
    import 'leaflet.markercluster/dist/MarkerCluster.css';
    import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
    import markerIcon from 'leaflet/dist/images/marker-icon.png';
    import markerIcon2x from 'leaflet/dist/images/marker-icon-2x.png';
    import markerShadow from 'leaflet/dist/images/marker-shadow.png';
    import { nearest, formatDistance, nearestOnPath } from '../lib/geo';

    /**
     * An explicit icon, NOT L.Icon.Default.mergeOptions.
     *
     * Icon.Default always prepends its detected `imagePath` to whatever iconUrl
     * it is given, so passing bundled asset paths through mergeOptions produced
     * "https://unpkg.com/leaflet@1.9.4/dist/images//_astro/marker-icon-2x.png"
     * and every pin 404'd. Defining the icon outright sidesteps imagePath
     * entirely and cannot be broken by where the stylesheet happens to live.
     */
    const pinIcon = L.icon({
      iconUrl: markerIcon.src,
      iconRetinaUrl: markerIcon2x.src,
      shadowUrl: markerShadow.src,
      iconSize: [25, 41],
      iconAnchor: [12, 41],
      popupAnchor: [1, -34],
      shadowSize: [41, 41],
    });

    interface Loc {
      slug: string; title: string; category: string; categorySlug: string;
      categoryIcon: string; period: string | null; lat: number; lng: number;
      summary: string; hero: string | null; card: string | null; hasAudio: boolean;
    }

    const el = document.getElementById('map')!;
    const map = L.map(el, { scrollWheelZoom: true }).setView([46.8, -121.5], 6);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution:
        '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    const cluster = (L as any).markerClusterGroup({
      showCoverageOnHover: false,
      maxClusterRadius: 46,
    });
    map.addLayer(cluster);

    let all: Loc[] = [];
    let markers: Record<string, L.Marker> = {};
    let activeCategory = 'all';

    /** Hand off to the phone's map app for actual turn-by-turn navigation. */
    const directionsUrl = (l: { lat: number; lng: number }) =>
      `https://www.google.com/maps/dir/?api=1&destination=${l.lat},${l.lng}`;

    // "Route here" inside a popup drops the place into the destination field and
    // runs the search, which is the shortest path from "this looks interesting"
    // to "show me what else is on the way".
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest?.('[data-set-destination]') as HTMLElement | null;
      if (!btn) return;
      const hit = all.find((x) => x.slug === btn.dataset.setDestination);
      if (!hit) return;
      openRoute();
      (document.getElementById('route-to') as HTMLInputElement).value = hit.title;
      const fromField = document.getElementById('route-from') as HTMLInputElement;
      if (fromField.value.trim()) routeForm.requestSubmit();
      else fromField.focus();
      map.closePopup();
    });

    function popupHtml(l: Loc) {
      const img = l.card
        ? `<img src="${l.card}" alt="" style="width:100%;height:110px;object-fit:cover;border-radius:6px;margin-bottom:6px"${
            l.hero ? ` onerror="this.onerror=null;this.src='${l.hero}'"` : ''
          }>`
        : '';
      const meta = [l.category, l.period, l.hasAudio ? '🎧' : null].filter(Boolean).join(' · ');
      return `${img}<strong style="font-size:1rem">${l.title}</strong><br>
        <span style="color:#5a5246;font-size:0.8rem">${meta}</span>
        <p style="margin:6px 0;font-size:0.85rem">${l.summary}</p>
        <a href="/locations/${l.slug}" style="font-weight:600">Read the full story →</a><br>
        <a href="${directionsUrl(l)}" target="_blank" rel="noopener" style="font-size:0.85rem">🧭 Directions</a>
        <button type="button" data-set-destination="${l.slug}"
                style="margin-left:0.5rem;font:inherit;font-size:0.85rem;background:none;border:0;padding:0;color:inherit;text-decoration:underline;cursor:pointer">
          Route here
        </button>`;
    }

    function render(subset: Loc[], fit = true) {
      cluster.clearLayers();
      markers = {};
      for (const l of subset) {
        const m = L.marker([l.lat, l.lng], { icon: pinIcon }).bindPopup(popupHtml(l), { maxWidth: 280 });
        markers[l.slug] = m;
        cluster.addLayer(m);
      }
      if (fit && subset.length) map.fitBounds(cluster.getBounds().pad(0.15));
    }

    const byCategory = (cat: string) =>
      cat === 'all' ? all : all.filter((l) => l.categorySlug === cat);

    fetch(el.dataset.locationsUrl!)
      .then((r) => r.json())
      .then((data: Loc[]) => {
        all = data;
        render(all);

        // Deep link: /map#slug opens that marker.
        const target = location.hash.slice(1);
        if (target && markers[target]) {
          map.setView(markers[target].getLatLng(), 13);
          setTimeout(() => markers[target].openPopup(), 400);
        }
        if (new URLSearchParams(location.search).get('mode') === 'route') {
          openRoute();
        }
      })
      .catch(() => {
        el.innerHTML =
          '<p style="padding:2rem;text-align:center">The map data could not load. <a href="/categories">Browse by category</a> instead.</p>';
      });

    // --- category filter ---------------------------------------------------
    document.getElementById('filters')!.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button.pill') as HTMLButtonElement | null;
      if (!btn) return;
      document.querySelectorAll('#filters .pill').forEach((p) => {
        p.classList.toggle('active', p === btn);
        p.setAttribute('aria-pressed', String(p === btn));
      });
      activeCategory = btn.dataset.cat!;
      document.getElementById('filter-current')!.textContent = btn.dataset.label!;
      // With a route on screen, filtering narrows the stops ALONG that route
      // rather than silently dropping back to the whole corpus.
      if (activeRoute) void applyRoute();
      else render(byCategory(activeCategory));
    });

    // --- results panel -----------------------------------------------------
    const results = document.getElementById('results')!;
    const resultsList = document.getElementById('results-list')!;
    const resultsTitle = document.getElementById('results-title')!;

    function showResults(title: string, items: Array<{ l: Loc; note: string }>) {
      resultsTitle.textContent = title;
      resultsList.innerHTML = items
        .map(
          ({ l, note }) => `<li>
            <span><a href="/locations/${l.slug}">${l.title}</a>
              <span class="muted" style="font-size:0.85rem"> · ${l.category}${l.hasAudio ? ' · 🎧' : ''}</span>
              <a href="${directionsUrl(l)}" target="_blank" rel="noopener"
                 style="font-size:0.85rem;margin-left:0.4rem">🧭 Directions</a>
            </span>
            <span class="dist">${note}</span>
          </li>`
        )
        .join('');
      results.hidden = false;
    }

    // --- locate me ---------------------------------------------------------
    const locateBtn = document.getElementById('locate') as HTMLButtonElement;
    const locateStatus = document.getElementById('locate-status')!;
    let userLayer: L.LayerGroup | null = null;

    locateBtn.addEventListener('click', () => {
      if (!('geolocation' in navigator)) {
        locateStatus.textContent = 'This device cannot report a location.';
        return;
      }
      locateBtn.disabled = true;
      locateStatus.textContent = 'Locating…';
      window.pnwTrack?.('find-near-me');

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          locateBtn.disabled = false;
          const { latitude: lat, longitude: lng, accuracy } = pos.coords;

          if (userLayer) map.removeLayer(userLayer);
          userLayer = L.layerGroup([
            L.circle([lat, lng], {
              radius: accuracy,
              color: '#2b6cff', weight: 1, fillColor: '#2b6cff', fillOpacity: 0.12,
            }),
            L.circleMarker([lat, lng], {
              radius: 7, color: '#fff', weight: 2, fillColor: '#2b6cff', fillOpacity: 1,
            }).bindPopup('You are here'),
          ]).addTo(map);

          const close = nearest({ lat, lng }, byCategory(activeCategory), 8);
          if (!close.length) {
            locateStatus.textContent = 'Nothing in this category nearby.';
            return;
          }
          map.setView([lat, lng], 9);
          locateStatus.textContent = `Nearest is ${formatDistance(close[0].miles)} away.`;
          showResults(
            'Closest to you',
            close.map((l) => ({ l: l as unknown as Loc, note: `${formatDistance(l.miles)} away` }))
          );
        },
        (err) => {
          locateBtn.disabled = false;
          locateStatus.textContent =
            err.code === 1
              ? 'Location permission was declined. Pan the map instead.'
              : 'Could not get a location fix. Pan the map instead.';
        },
        { enableHighAccuracy: true, timeout: 10000, maximumAge: 30000 }
      );
    });

    // --- route corridor ----------------------------------------------------
    const routeToggle = document.getElementById('route-toggle') as HTMLButtonElement;
    const routeForm = document.getElementById('route-form') as HTMLFormElement;
    const routeStatus = document.getElementById('route-status')!;
    const routeClear = document.getElementById('route-clear') as HTMLButtonElement;
    let routeLine: L.Polyline | null = null;
    let routeEnds: L.LayerGroup | null = null;

    function openRoute() {
      routeForm.hidden = false;
      routeToggle.setAttribute('aria-expanded', 'true');
      (document.getElementById('route-from') as HTMLInputElement).focus();
    }

    routeToggle.addEventListener('click', () => {
      const open = routeForm.hidden;
      if (open) openRoute();
      else {
        routeForm.hidden = true;
        routeToggle.setAttribute('aria-expanded', 'false');
      }
    });

    /** Nominatim, one request at a time, per their usage policy. */
    async function geocode(q: string): Promise<{ lat: number; lng: number } | null> {
      const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(q)}`;
      const res = await fetch(url, { headers: { Accept: 'application/json' } });
      if (!res.ok) return null;
      const json = await res.json();
      if (!json.length) return null;
      return { lat: parseFloat(json[0].lat), lng: parseFloat(json[0].lon) };
    }

    interface DrivingRoute {
      path: Array<{ lat: number; lng: number }>;
      miles: number;
      minutes: number;
      /** Whether the chosen route crosses on a ferry. */
      usesFerry: boolean;
    }

    /**
     * Real driving geometry from OSRM, on the public instance FOSSGIS runs for
     * openstreetmap.org.
     *
     * A straight line is not an approximation of a drive in this region, it is a
     * different shape. Seattle to Port Townsend is about 40 miles across the
     * water and roughly twice that by road, so a straight corridor invents stops
     * on the far shore and hides the ones actually passed. OSRM's car profile
     * routes over ferries, which is correct here — in Puget Sound the ferries
     * ARE the road.
     *
     * Cached per session so re-running a search does not re-hit a service
     * somebody else pays for.
     */
    const OSRM = 'https://routing.openstreetmap.de/routed-car';

    async function fetchDrivingRoute(
      from: { lat: number; lng: number },
      to: { lat: number; lng: number }
    ): Promise<DrivingRoute | null> {
      const key = `pnw-route:${from.lat.toFixed(4)},${from.lng.toFixed(4)}>${to.lat.toFixed(4)},${to.lng.toFixed(4)}`;
      try {
        const hit = sessionStorage.getItem(key);
        if (hit) return JSON.parse(hit) as DrivingRoute;
      } catch {
        /* private browsing — just fetch */
      }

      // steps=true so ferry legs can be detected: OSRM marks them mode:"ferry",
      // and in Puget Sound whether the route sails matters more to a traveller
      // than almost anything else about it.
      //
      // No `exclude=ferry` here: this instance rejects the exclude parameter
      // outright ("Exclude flag combination is not supported"), for ferries and
      // motorways alike. An avoid-ferries toggle would have failed every time,
      // and silently — so it is not offered rather than offered and broken.
      const params = new URLSearchParams({
        overview: 'simplified',
        geometries: 'geojson',
        steps: 'true',
      });

      const url = `${OSRM}/route/v1/driving/${from.lng},${from.lat};${to.lng},${to.lat}?${params}`;
      const res = await fetch(url, { signal: AbortSignal.timeout(12000) });
      if (!res.ok) return null;

      const json = await res.json();
      if (json.code !== 'Ok' || !json.routes?.length) return null;

      const r = json.routes[0];
      const usesFerry = (r.legs ?? []).some((leg: any) =>
        (leg.steps ?? []).some((step: any) => step.mode === 'ferry')
      );

      const route: DrivingRoute = {
        path: (r.geometry.coordinates as Array<[number, number]>).map(([lng, lat]) => ({ lat, lng })),
        miles: r.distance / 1609.344,
        minutes: r.duration / 60,
        usesFerry,
      };
      try {
        sessionStorage.setItem(key, JSON.stringify(route));
      } catch {
        /* quota or private mode — the cache is an optimisation, not a requirement */
      }
      return route;
    }

    /**
     * How much longer the whole trip takes if you go via each place, in minutes.
     *
     *     detour = time(start -> place -> end) - time(start -> end)
     *
     * This is the question a traveller is actually asking, and it is not the
     * same as the round trip from the nearest point on the road. An earlier
     * version measured "leave the route here, drive there, drive back to the
     * same spot", which invents a return leg that does not exist when the place
     * sits at your destination: Fort Nisqually, inside the destination city on a
     * Bainbridge-to-Tacoma run, was reported as 39 minutes out of the way when
     * going via it costs 25. Across water the overstatement was far worse —
     * Pike Place came out at 248 minutes against a true 87.
     *
     * Still one table request. The matrix is asked for with the start and every
     * candidate as sources, and every candidate plus the end as destinations, so
     * row 0 gives start->place and the last column gives place->end.
     *
     * Row 0 doubles as the ordering key. Sorting by geometric progress along the
     * line puts a place where the road passes CLOSEST to it, which for anything
     * across water is nowhere near where you actually reach it: on a Bainbridge
     * to Moses Lake run the whole of downtown Seattle scored a progress of zero,
     * because the nearest approach is back at the start across Elliott Bay, and
     * the list claimed you would pass Pike Place before leaving the island.
     */
    const TABLE_LIMIT = 45; // public OSRM instances cap total coordinates

    interface DetourTime {
      /** Extra minutes the whole trip costs if you go via this place. */
      detour: number;
      /** Driving minutes from the start to this place — i.e. when you reach it. */
      fromStart: number;
    }

    async function fetchDetourTimes(
      start: { lat: number; lng: number },
      targets: Array<{ lat: number; lng: number }>,
      end: { lat: number; lng: number },
      baselineMinutes: number
    ): Promise<DetourTime[] | null> {
      const n = targets.length;
      if (!n || n > TABLE_LIMIT) return null;

      const coords = [start, ...targets, end].map((p) => `${p.lng},${p.lat}`).join(';');
      // sources: the start (0) and every candidate (1..n)
      const sources = [0, ...Array.from({ length: n }, (_, i) => i + 1)].join(';');
      // destinations: every candidate (1..n) then the end (n+1)
      const destinations = [...Array.from({ length: n }, (_, i) => i + 1), n + 1].join(';');

      const url = `${OSRM}/table/v1/driving/${coords}?sources=${sources}&destinations=${destinations}&annotations=duration`;
      const res = await fetch(url, { signal: AbortSignal.timeout(12000) });
      if (!res.ok) return null;

      const json = await res.json();
      if (json.code !== 'Ok' || !Array.isArray(json.durations)) return null;

      const startToPlace: Array<number | null> = json.durations[0] ?? [];
      return targets.map((_, i) => {
        const out = startToPlace[i];
        const back = json.durations[i + 1]?.[n];
        if (typeof out !== 'number' || typeof back !== 'number') {
          return { detour: NaN, fromStart: NaN };
        }
        return {
          // Never negative: a place genuinely on the route can measure a few
          // seconds "faster" than the baseline through routing noise.
          detour: Math.max(0, (out + back) / 60 - baselineMinutes),
          fromStart: out / 60,
        };
      });
    }

    /** The route currently drawn, so a category change can re-filter against it. */
    let activeRoute:
      | {
          path: Array<{ lat: number; lng: number }>;
          label: string;
          budget: number;
          start: { lat: number; lng: number };
          end: { lat: number; lng: number };
          /** Trip time without any stop; null when routing fell back to a straight line. */
          baselineMinutes: number | null;
        }
      | null = null;

    /**
     * How far out of your way a stop is.
     *
     * Prefers real driving minutes when the table service answered. Distance
     * from the road is the fallback, and a poor proxy: two miles away across a
     * river can be twenty minutes each way.
     */
    function detourNote(miles: number, minutes: number): string {
      if (Number.isFinite(minutes)) {
        // Under a couple of minutes is not a detour anyone weighs up.
        return minutes < 2 ? 'on the way' : `about ${Math.round(minutes)} min out of your way`;
      }
      return miles < 0.5 ? 'on the way' : `${formatDistance(miles)} off route`;
    }

    /**
     * Straight-line miles a place can sit from the road and still fit a time
     * budget. A detour cannot beat the crow flies, so at a generous 60 mph each
     * way `budget / 2` miles is a hard upper bound. Deliberately over-includes:
     * this only builds the shortlist that real driving times are then measured
     * against.
     */
    const MAX_PREFILTER_MILES = 40;

    async function applyRoute(): Promise<{ count: number; timed: boolean }> {
      if (!activeRoute) return { count: 0, timed: false };
      const { path, label, budget, start, end, baselineMinutes } = activeRoute;

      // One traversal yields distance, the point where you would leave the road,
      // and progress along the drive.
      const reach = Math.min(budget / 2, MAX_PREFILTER_MILES);
      const shortlist = byCategory(activeCategory)
        .map((l) => ({ l, near: nearestOnPath(l, path) }))
        .filter((x) => x.near.distance <= reach)
        .sort((a, b) => a.near.distance - b.near.distance)
        .slice(0, TABLE_LIMIT);

      const title = `Along the way: ${label}`;

      const finish = (
        rows: Array<{ l: Loc; near: any; minutes: number; fromStart: number }>,
        timed: boolean
      ) => {
        // Ordered by when you actually REACH each place — driving minutes from
        // the start. Geometric progress along the line is the wrong key: it
        // places a stop where the road runs closest to it, which across water is
        // nowhere near where you get to it, and it produces huge ties (every
        // place nearest the route's first point scores exactly zero) that then
        // fall back to alphabetical. Distance is only the fallback when no
        // driving times are available.
        rows.sort((a, b) =>
          Number.isFinite(a.fromStart) && Number.isFinite(b.fromStart)
            ? a.fromStart - b.fromStart
            : a.near.progress - b.near.progress || a.near.distance - b.near.distance
        );
        render(
          rows.map((x) => x.l),
          false
        );
        if (!rows.length) {
          results.hidden = true;
          return { count: 0, timed };
        }
        showResults(
          title,
          rows.map(({ l, near, minutes }) => ({ l, note: detourNote(near.distance, minutes) }))
        );
        return { count: rows.length, timed };
      };

      if (!shortlist.length) {
        results.hidden = true;
        routeStatus.textContent = `Nothing within ${budget} minutes of that route. Try a longer detour.`;
        return { count: 0, timed: true };
      }

      let times: DetourTime[] | null = null;
      if (baselineMinutes !== null) {
        try {
          times = await fetchDetourTimes(
            start,
            shortlist.map((x) => x.l),
            end,
            baselineMinutes
          );
        } catch {
          times = null;
        }
      }

      if (!activeRoute) return { count: 0, timed: false };

      if (!times) {
        // No driving times available, so the time budget cannot be honoured.
        // Fall back to the geometric shortlist and say so rather than pretending
        // the numbers mean what they usually mean.
        return finish(
          shortlist.map((x) => ({ ...x, minutes: NaN, fromStart: NaN })),
          false
        );
      }

      const withinBudget = shortlist
        .map((x, i) => ({ ...x, minutes: times![i].detour, fromStart: times![i].fromStart }))
        .filter((x) => Number.isFinite(x.minutes) && x.minutes <= budget);

      if (!withinBudget.length) {
        render([], false);
        results.hidden = true;
        routeStatus.textContent = `Nothing within ${budget} minutes of that route. Try a longer detour.`;
        return { count: 0, timed: true };
      }

      return finish(withinBudget, true);
    }

    function clearRoute() {
      activeRoute = null;
      if (routeLine) {
        map.removeLayer(routeLine);
        routeLine = null;
      }
      if (routeEnds) {
        map.removeLayer(routeEnds);
        routeEnds = null;
      }
      results.hidden = true;
      resultsList.innerHTML = '';
      routeStatus.textContent = '';
      routeClear.hidden = true;
      render(byCategory(activeCategory));
    }

    routeClear.addEventListener('click', clearRoute);

    routeForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fromQ = (document.getElementById('route-from') as HTMLInputElement).value.trim();
      const toQ = (document.getElementById('route-to') as HTMLInputElement).value.trim();
      const budget = Number((document.getElementById('route-detour') as HTMLSelectElement).value);
      if (!fromQ || !toQ) return;

      routeStatus.textContent = 'Looking up both places…';
      window.pnwTrack?.('route-plan');

      try {
        const from = await geocode(fromQ);
        // Sequential, not Promise.all: Nominatim asks for at most one request
        // per second and this is a courtesy we can afford to pay.
        const to = from ? await geocode(toQ) : null;

        if (!from || !to) {
          routeStatus.textContent = 'Could not find one of those places. Try adding a state.';
          return;
        }

        routeStatus.textContent = 'Finding the driving route…';

        let route: DrivingRoute | null = null;
        try {
          route = await fetchDrivingRoute(from, to);
        } catch {
          route = null;
        }

        // Falling back to a straight line beats failing outright, but it is a
        // materially different answer, so the UI says so rather than quietly
        // presenting a guess as a route.
        const path = route ? route.path : [from, to];
        const label = `${fromQ} → ${toQ}`;

        if (routeLine) map.removeLayer(routeLine);
        routeLine = L.polyline(
          path.map((pt) => [pt.lat, pt.lng] as [number, number]),
          route
            ? { color: '#a14e2c', weight: 5, opacity: 0.8 }
            : { color: '#a14e2c', weight: 4, opacity: 0.6, dashArray: '8 6' }
        ).addTo(map);

        if (routeEnds) map.removeLayer(routeEnds);
        routeEnds = L.layerGroup(
          [from, to].map((pt, i) =>
            L.circleMarker([pt.lat, pt.lng], {
              radius: 6,
              color: '#fff',
              weight: 2,
              fillColor: '#1f3d2b',
              fillOpacity: 1,
            }).bindPopup(i === 0 ? `Start: ${fromQ}` : `End: ${toQ}`)
          )
        ).addTo(map);

        activeRoute = {
          path,
          label,
          budget,
          start: from,
          end: to,
          // Without a real route there is no trip time to subtract, so detour
          // minutes are not computable and the list falls back to distance.
          baselineMinutes: route ? route.minutes : null,
        };
        map.fitBounds(routeLine.getBounds().pad(0.15));
        routeClear.hidden = false;
        routeStatus.textContent = 'Measuring detour times…';
        const { count: found, timed } = await applyRoute();

        if (found) {
          const drive = route
            ? `${Math.round(route.miles)} mi drive, about ${
                route.minutes >= 90
                  ? `${Math.floor(route.minutes / 60)} h ${Math.round(route.minutes % 60)} min`
                  : `${Math.round(route.minutes)} min`
              }`
            : 'straight-line estimate — the driving route was unavailable';

          const ferryNote = route?.usesFerry
            ? ' ⛴ This route sails — the drive time excludes the crossing and any wait at the terminal.'
            : '';
          const budgetNote = timed
            ? `within ${budget} minutes of the route`
            : `near the route (detour times unavailable, so these are by map distance)`;
          routeStatus.textContent =
            `${found} place${found === 1 ? '' : 's'} ${budgetNote} (${drive}).` + ferryNote;
        }
      } catch {
        routeStatus.textContent = 'Routing is unavailable right now. Try again shortly.';
      }
    });

  </script>
</Base>
