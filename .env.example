# Copy to .env for local development. Every value here is PUBLIC — it ships in
# the built HTML. Nothing secret belongs in this file or in this repo.

# Canonical origin. Used for canonical tags, OG URLs, sitemap, JSON-LD.
SITE_URL=https://pnwhistoricalexplorer.com

# Where media is served from. Empty = same-origin /media/... (local dev, or a
# deploy that ships images in the repo). Set to an R2/CDN origin in production:
#   PUBLIC_MEDIA_BASE=https://media.pnwhistoricalexplorer.com
PUBLIC_MEDIA_BASE=

# Amazon Associates tag, e.g. "pnwhistory-20". Appended to book links at build
# time so it is never pasted into 95 markdown files. Not secret — it is visible
# in the final outbound link.
PUBLIC_AMAZON_TAG=

# GoatCounter subdomain only, e.g. "pnwhistory".
PUBLIC_GOATCOUNTER_CODE=

# Google Search Console verification token (the content of the meta tag).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Build the /admin dashboards. Leave unset for public deploys until the routes
# are behind Cloudflare Access.
INCLUDE_ADMIN=

# --- media:push only (never committed, never shipped to the browser) ---------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pnw-explorer-media
